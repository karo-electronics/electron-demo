{
  "name": "karo-electron-demo",
  "version": "0.0.1",
  "description": "A minimal Electron Demo application",
  "main": "main.js",
  "scripts": {
    "start": "electron main.js --no-sandbox --disable-gpu-sandbox --enable-features=UseOzonePlatform --ozone-platform=wayland --use-gl=egl --ignore-gpu-blacklist --enable-zero-copy --enable-gpu-rasterization --enable-native-gpu-memory-buffers",
    "test": "electron --inspect --remote-debugging-port=9223 main.js --no-sandbox"
  },
  "keywords": [
    "Ka-Ro",
    "Electron",
    "Demo"
  ],
  "repository": {},
  "author": "Markus Bauer <mb@karo-electronics.de>",
  "license": "CC0-1.0",
  "devDependencies": {
    "electron": "^34.5.8"
  }
}
